[Unit]
Description=Verigo email verification web service
After=network-online.target verigo-postgres-tunnel.service
Wants=network-online.target
# Soft dependency: tunnel is required only when VERIGO_POSTGRES_ENABLED=true.
# Keep Wants (not Requires) so SQLite mode still boots if the tunnel unit is stopped.
Wants=verigo-postgres-tunnel.service

[Service]
Type=simple
User=verigo
Group=verigo
WorkingDirectory=/opt/verigo/current
EnvironmentFile=/etc/verigo/verigo.env
ExecStart=/opt/verigo/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/verigo/data

[Install]
WantedBy=multi-user.target
