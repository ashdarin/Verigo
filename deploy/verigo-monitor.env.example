# Optional HTTPS webhook for alerts and recovery messages.
VERIGO_ALERT_WEBHOOK_URL=
VERIGO_ALERT_REPEAT_MINUTES=360
VERIGO_MONITOR_DISK_PERCENT=85
VERIGO_MONITOR_BACKUP_MAX_AGE_HOURS=27
VERIGO_MONITOR_QUEUE_LIMIT=10
# Exclude cache refresh work from these user-visible task alerts.
VERIGO_MONITOR_QUEUE_OLDEST_SECONDS=900
VERIGO_MONITOR_RUNNING_WITHOUT_LEASE_SECONDS=300
VERIGO_MONITOR_WORKER_HEARTBEAT_SECONDS=300
VERIGO_MONITOR_PROVIDER_COOLDOWN_MAX_SECONDS=1800
VERIGO_MONITOR_PUBLIC_BASE_URL=https://verigo.site
VERIGO_MONITOR_READINESS_URL=http://127.0.0.1:18000/api/internal/readiness
VERIGO_MONITOR_QUALITY_URL=http://127.0.0.1:18000/api/internal/quality
VERIGO_MONITOR_POSTGRES_TUNNEL_PORT=15433
VERIGO_MONITOR_POSTGRES_TUNNEL_UNIT=verigo-postgres-worker-tunnel
VERIGO_MONITOR_CHECK_LOCAL_BACKUP=0
VERIGO_MONITOR_ASSET_MARKER=risk-signals-v3
VERIGO_MONITOR_DATABASE_ENV_FILE=/etc/verigo/verigo-worker.env
# Alert when pressure is seen in the 60-second runtime window while the
# provider's adaptive concurrency is below its configured limit.
VERIGO_MONITOR_PROVIDER_PRESSURE_LAST_60_SECONDS=1
# Quality alerts require a representative recent sample, then check the last
# 24 hours for delivery uncertainty, end-to-end p95 latency, and active review.
VERIGO_MONITOR_QUALITY_MIN_SAMPLE=200
VERIGO_MONITOR_UNCONFIRMED_PERCENT=15
VERIGO_MONITOR_P95_SECONDS=180
VERIGO_MONITOR_REVIEW_BACKLOG=25
