[Unit]
Description=Verigo remote worker API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=verigo
Group=verigo
WorkingDirectory=/opt/verigo/current
EnvironmentFile=/etc/verigo/verigo-worker.env
ExecStart=/opt/verigo/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 4
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/verigo/data

[Install]
WantedBy=multi-user.target
