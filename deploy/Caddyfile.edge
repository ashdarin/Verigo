# Public DNS points to the Hong Kong edge. The application and worker API stay
# in Shanghai and are exposed only through verigo-data-app-tunnel.service.
http://www.verigo.site {
    redir https://verigo.site{uri} permanent
}

https://www.verigo.site {
    redir https://verigo.site{uri} permanent
}

verigo.site {
    encode zstd gzip

    request_body {
        max_size 8MB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    route {
        @worker_api path /api/workers/*
        reverse_proxy @worker_api 127.0.0.1:18001 {
            lb_try_duration 45s
            lb_try_interval 250ms
        }

        reverse_proxy 127.0.0.1:18000 {
            lb_try_duration 10s
        }
    }
}
