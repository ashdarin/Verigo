# This configuration is retained for direct-app recovery. The Shanghai role
# normally keeps Caddy disabled because public DNS terminates on the Hong Kong
# edge and forwards to ports 8000/8001 over the application tunnel.
http://www.verigo.site {
    redir https://verigo.site{uri} permanent
}

https://www.verigo.site {
    redir https://verigo.site{uri} permanent
}

verigo.site {
    encode zstd gzip

    request_body {
        max_size 8MB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    route {
        @worker_api path /api/workers/*
        reverse_proxy @worker_api 127.0.0.1:8001 {
            lb_try_duration 45s
            lb_try_interval 250ms
        }

        reverse_proxy 127.0.0.1:8000 {
            lb_try_duration 10s
        }
    }
}
