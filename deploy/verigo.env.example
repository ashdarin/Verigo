VERIGO_APP_NAME=Verigo
# Zero removes the total size limit for a submitted task. Remote worker child
# tasks are automatically capped by VERIGO_REMOTE_WORKER_MAX_EMAILS.
VERIGO_MAX_EMAILS=0
VERIGO_MAX_WORKERS=8
VERIGO_REMOTE_WORKER_MAX_EMAILS=5000
# Cloud Studio retains its existing limit. Gmail's provider-wide scheduler cap
# remains authoritative when Cloud Shell workers use 25 local processes.
VERIGO_CLOUDSTUDIO_MAX_WORKERS=4
VERIGO_CLOUDSHELL_MAX_WORKERS=25
VERIGO_CODEARTS_MAX_WORKERS=16
# Number of serial remote claim loops in each Cloud Shell workspace. This is
# independent of the per-shard process limit above.
VERIGO_CLOUDSHELL_WORKER_PROCESSES=2
VERIGO_CLOUDSHELL_SECONDARY_WORKER_PROCESSES=1
# Provider caps remain global. Enterprise domains start conservatively and
# learn upward after sustained successful checks.
VERIGO_SCHEDULER_GMAIL_CONCURRENCY=25
VERIGO_SCHEDULER_MICROSOFT_CONCURRENCY=64
VERIGO_SCHEDULER_DEFAULT_DOMAIN_CONCURRENCY=4
VERIGO_SCHEDULER_DOMAIN_MAX_CONCURRENCY=16
VERIGO_SCHEDULER_REMOTE_SHARD_SIZE=25
VERIGO_SCHEDULER_CLAIM_SCAN_LIMIT=64
VERIGO_SCHEDULER_SUCCESSES_PER_STEP=20
# Discovery begins at a higher controlled concurrency and climbs faster only
# after stable receiver responses. Pressure signals still immediately reduce it.
VERIGO_PROSPECTING_SCHEDULER_INITIAL_DOMAIN_CONCURRENCY=8
VERIGO_PROSPECTING_SCHEDULER_SUCCESSES_PER_STEP=8
VERIGO_PROSPECTING_SCHEDULER_STEP_SIZE=2
VERIGO_SCHEDULER_COOLDOWN_SECONDS=120
VERIGO_MAX_GUEST_EMAILS=100
VERIGO_FREE_SINGLE_DAILY_LIMIT=20
VERIGO_EMAIL_VERIFICATION_TRIAL_CREDITS=10
VERIGO_TRIAL_CREDIT_DAYS=7
VERIGO_TRIAL_NETWORK_LIMIT=2
VERIGO_TRIAL_NETWORK_WINDOW_DAYS=7
# Comma-separated domains rejected at registration. Extend this list for your risk profile.
VERIGO_BLOCKED_EMAIL_DOMAINS=mailinator.com,yopmail.com,guerrillamail.com,tempmail.com,temp-mail.org,10minutemail.com,getnada.com,dispostable.com
VERIGO_TURNSTILE_SITE_KEY=
VERIGO_TURNSTILE_SECRET_KEY=
VERIGO_ADMIN_EMAILS=
# Private domain-contact discovery beta. Keep this disabled unless the allowed
# account has been deliberately enrolled. This feature is not public.
VERIGO_PROSPECTING_BETA_ENABLED=false
VERIGO_PROSPECTING_BETA_ALLOWED_EMAILS=
VERIGO_PROSPECTING_BETA_MAX_CANDIDATES=1000
# A random secret used only to hash daily visitor identifiers. Keep this stable.
VERIGO_METRICS_SALT=
# Restricts detailed scheduler and worker readiness to the server monitor.
VERIGO_MONITOR_TOKEN=
VERIGO_MAX_WORKERS=8
VERIGO_MAX_PARALLEL_JOBS=1
VERIGO_MAX_PENDING_JOBS=8
# Optional merchant-hosted payment page. Available placeholders: {order_id},
# {amount_fen}, {credits}, {return_url}. Do not mark an order paid from a browser.
VERIGO_PAYMENT_CHECKOUT_URL=
# Shared secret used to validate the payment gateway's server callback.
VERIGO_PAYMENT_WEBHOOK_TOKEN=
VERIGO_QQ_SMTP_PER_MX=1
VERIGO_QQ_SMTP_WAIT_SECONDS=300
VERIGO_QQ_BACKOFF_BASE_SECONDS=30
VERIGO_QQ_BACKOFF_MAX_SECONDS=900
VERIGO_QQ_AVATAR_TIMEOUT_SECONDS=8
VERIGO_QQ_AVATAR_WAIT_SECONDS=20
VERIGO_QQ_AVATAR_MIN_INTERVAL_SECONDS=1
# Token for a Cloud Studio startup connectivity probe. Keep this secret.
VERIGO_CLOUDSTUDIO_PROBE_TOKEN=
# Enables a fixed Cloud Studio worker to authenticate and poll. It handles domestic
# email domains; use a comma-separated account allowlist for a staged rollout, or *.
VERIGO_TENCENT_QQ_WORKER_ENABLED=false
VERIGO_TENCENT_QQ_WORKER_ALLOWED_EMAILS=*
VERIGO_TENCENT_QQ_WORKER_TOKEN=
# The Google Cloud Shell worker handles foreign email domains. Its legacy Gmail
# setting names remain for compatibility with the existing node configuration.
VERIGO_GMAIL_WORKER_ENABLED=false
VERIGO_GMAIL_WORKER_ALLOWED_EMAILS=*
VERIGO_GMAIL_WORKER_TOKEN=
# A persistent Huawei CodeArts worker for foreign and enterprise email domains.
# It is an independent worker target; its lifecycle is not controlled by Verigo.
VERIGO_CODEARTS_WORKER_ENABLED=false
VERIGO_CODEARTS_WORKER_ALLOWED_EMAILS=*
VERIGO_CODEARTS_WORKER_TOKEN=
# Optional second Cloud Shell account. Both nodes pull the same foreign-email queue.
VERIGO_GOOGLE_CLOUDSHELL_SECONDARY_ENABLED=false
VERIGO_GOOGLE_CLOUDSHELL_SECONDARY_USER=
VERIGO_GOOGLE_CLOUDSHELL_SECONDARY_QUOTA_PROJECT=
VERIGO_GOOGLE_CLOUDSHELL_SECONDARY_ADC_PATH=/opt/verigo/data/cloudshell_account2_adc.json
VERIGO_GOOGLE_CLOUDSHELL_SECONDARY_SSH_KEY_PATH=/opt/verigo/data/cloudshell-account2_rsa
VERIGO_GOOGLE_CLOUDSHELL_SECONDARY_SSH_KNOWN_HOSTS_PATH=/opt/verigo/data/cloudshell_account2_known_hosts
# Optional additional Cloud Shell accounts. The JSON file contains only
# account/workspace paths and identifiers; keep ADC and SSH private files at
# 0600 outside Git. Accounts are added to the same gmail worker target.
VERIGO_GOOGLE_CLOUDSHELL_ACCOUNTS_FILE=/opt/verigo/data/cloudshell-accounts.json
VERIGO_CLOUDSHELL_QUOTA_COOLDOWN_SECONDS=3600
VERIGO_CLOUDSHELL_COORDINATOR_ENABLED=true
VERIGO_CLOUDSHELL_ACTIVE_MIN_ACCOUNTS=2
VERIGO_CLOUDSHELL_ACTIVE_MAX_ACCOUNTS=4
VERIGO_CLOUDSHELL_QUEUE_PER_ACTIVE_ACCOUNT=2
# Leave at 0 unless you know the account's daily soft budget.
VERIGO_CLOUDSHELL_SOFT_QUOTA_UNITS=0
# Optional on-demand lifecycle control through Tencent Cloud API 3.0.
VERIGO_CLOUDSTUDIO_LIFECYCLE_ENABLED=false
VERIGO_CLOUDSTUDIO_SECRET_ID=
VERIGO_CLOUDSTUDIO_SECRET_KEY=
VERIGO_CLOUDSTUDIO_REGION=
VERIGO_CLOUDSTUDIO_SPACE_KEY=
VERIGO_CLOUDSTUDIO_SSH_ENABLED=false
VERIGO_CLOUDSTUDIO_SSH_KEY_PATH=/opt/verigo/data/cloudstudio_worker_ed25519
VERIGO_CLOUDSTUDIO_SSH_KNOWN_HOSTS_PATH=/opt/verigo/data/cloudstudio_known_hosts
# Optional second Cloud Studio workspace for domestic non-QQ email. QQ remains
# bound to the primary Cloud Studio worker and is always serial.
VERIGO_CLOUDSTUDIO_DOMESTIC_WORKER_ENABLED=false
VERIGO_CLOUDSTUDIO_DOMESTIC_WORKER_TOKEN=
VERIGO_CLOUDSTUDIO_SECONDARY_LIFECYCLE_ENABLED=false
VERIGO_CLOUDSTUDIO_SECONDARY_SECRET_ID=
VERIGO_CLOUDSTUDIO_SECONDARY_SECRET_KEY=
VERIGO_CLOUDSTUDIO_SECONDARY_REGION=
VERIGO_CLOUDSTUDIO_SECONDARY_SPACE_KEY=
VERIGO_CLOUDSTUDIO_SECONDARY_SSH_ENABLED=false
VERIGO_CLOUDSTUDIO_SECONDARY_SSH_KEY_PATH=/opt/verigo/data/cloudstudio-account2_ed25519
VERIGO_CLOUDSTUDIO_SECONDARY_SSH_KNOWN_HOSTS_PATH=/opt/verigo/data/cloudstudio_account2_known_hosts
VERIGO_CLOUDSTUDIO_SSH_TOKEN_EXPIRY_SECONDS=300
VERIGO_CLOUDSTUDIO_WORKER_ONLINE_SECONDS=45
VERIGO_CLOUDSTUDIO_STARTUP_TIMEOUT_SECONDS=300
VERIGO_CLOUDSTUDIO_WAKE_MAX_ATTEMPTS=3
VERIGO_CLOUDSTUDIO_WAKE_RETRY_SECONDS=15
VERIGO_CLOUDSTUDIO_IDLE_STOP_SECONDS=600
VERIGO_CLOUDSTUDIO_LIFECYCLE_POLL_SECONDS=5
VERIGO_NODE_STALE_SECONDS=180
VERIGO_NODE_OFFLINE_SECONDS=540
VERIGO_SQLITE_BUSY_TIMEOUT_MS=30000
VERIGO_SQLITE_WRITE_RETRY_ATTEMPTS=3
VERIGO_SQLITE_WRITE_RETRY_DELAY_MS=100
VERIGO_RESULTS_DIR=/opt/verigo/data/results
VERIGO_DATABASE_PATH=/opt/verigo/data/verigo.db

# Optional, separate read-only company search catalogue. Do not point this at
# the application SQLite database. Keep it on a dedicated search node in production.
VERIGO_COMPANY_CATALOG_ENABLED=false
VERIGO_COMPANY_CATALOG_PATH=/opt/verigo/catalog/company_catalog.duckdb
VERIGO_COMPANY_CATALOG_QUERY_MEMORY_LIMIT=512MB
# Optional legacy Tinybird endpoint. Use a separate least-privilege READ
# token, never a workspace admin token.
VERIGO_COMPANY_CATALOG_TINYBIRD_URL=
VERIGO_COMPANY_CATALOG_TINYBIRD_TOKEN=
VERIGO_COMPANY_CATALOG_TINYBIRD_TIMEOUT_SECONDS=8
# Optional private Company Finder node. Point this at a local SSH tunnel, not
# a publicly reachable service address.
VERIGO_COMPANY_CATALOG_SERVICE_URL=
VERIGO_COMPANY_CATALOG_SERVICE_TOKEN=
VERIGO_COMPANY_CATALOG_SERVICE_TIMEOUT_SECONDS=8
VERIGO_MAX_IMPORT_BYTES=5242880
VERIGO_SESSION_TTL_DAYS=30
VERIGO_SECURE_COOKIES=true

VERIGO_SENDER_EMAIL=
VERIGO_SENDER_PASSWORD=
