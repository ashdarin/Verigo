# Keep every public URL on one host. Serving both hosts with the same HTML
# creates duplicate documents and leaves the canonical decision to crawlers.
http://www.verigo.site {
    redir https://verigo.site{uri} permanent
}

https://www.verigo.site {
    redir https://verigo.site{uri} permanent
}

verigo.site {
    encode zstd gzip

    request_body {
        max_size 8MB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    reverse_proxy 127.0.0.1:8000 {
        # Retry briefly while the application process is reloading during a
        # release, preventing crawlers from seeing a transient 502.
        lb_try_duration 10s
    }
}
