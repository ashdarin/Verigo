VERIGO_APP_NAME=Verigo
VERIGO_MAX_EMAILS=5000
VERIGO_MAX_GUEST_EMAILS=100
VERIGO_MAX_WORKERS=8
VERIGO_QQ_WORKER_MAX_WORKERS=6
VERIGO_MAX_PARALLEL_JOBS=2
VERIGO_MAX_PENDING_JOBS=20
VERIGO_RESULTS_DIR=/opt/verigo/data/results
VERIGO_DATABASE_PATH=/opt/verigo/data/verigo.db
VERIGO_SMTP_LIMITER_PATH=/opt/verigo/data/smtp_limiter.db
VERIGO_SMTP_HELO_HOST=mail.verigo.site
VERIGO_SMTP_MAIL_FROM=verify@verigo.site
VERIGO_SMTP_PER_MX=8
VERIGO_QQ_SMTP_PER_MX=6
VERIGO_WORKER_POLL_SECONDS=1
VERIGO_WORKER_LEASE_SECONDS=180
# Confidence-aware email verdict reuse. Stale rows are retained for auditing,
# but are never returned as a current verification result.
VERIGO_CACHE_DELIVERABLE_FIRST_DAYS=7
VERIGO_CACHE_DELIVERABLE_REPEAT_DAYS=14
VERIGO_CACHE_DELIVERABLE_STABLE_DAYS=30
VERIGO_CACHE_PERMANENT_DAYS=3
VERIGO_CACHE_MAILBOX_FULL_HOURS=2
VERIGO_CACHE_STALE_DAYS=90
VERIGO_CACHE_REFRESH_AHEAD_HOURS=24
VERIGO_CACHE_REFRESH_MIN_HITS=3
VERIGO_CACHE_REFRESH_COOLDOWN_HOURS=24
VERIGO_CACHE_REFRESH_MAX_PER_REQUEST=10
VERIGO_CACHE_REFRESH_MAX_QUEUED=100
VERIGO_VERIFICATION_PROBE_LEASE_SECONDS=180
VERIGO_CACHE_METRICS_FLUSH_SECONDS=5
# Optional public, domain-only disposable-email enrichment. It is cached in
# PostgreSQL and uses probe@domain rather than a customer's local-part.
VERIGO_DISPOSABLE_LOOKUP_ENABLED=false
VERIGO_DISPOSABLE_LOOKUP_URL=https://disposable.debounce.io/
VERIGO_DISPOSABLE_LOOKUP_TIMEOUT_SECONDS=0.8
# Bounded per-process background capacity. Public lookups never delay SMTP.
VERIGO_DISPOSABLE_LOOKUP_BACKGROUND_WORKERS=2
VERIGO_DISPOSABLE_LOOKUP_BACKGROUND_QUEUE=2
VERIGO_DISPOSABLE_LOOKUP_POSITIVE_CACHE_HOURS=720
VERIGO_DISPOSABLE_LOOKUP_NEGATIVE_CACHE_HOURS=168
VERIGO_DISPOSABLE_LOOKUP_FAILURE_CACHE_SECONDS=300
VERIGO_MAIL_HOST=
VERIGO_MAIL_PORT=587
VERIGO_MAIL_USERNAME=
VERIGO_MAIL_PASSWORD=
VERIGO_MAIL_FROM=
VERIGO_MAIL_STARTTLS=true
VERIGO_PASSWORD_RESET_MINUTES=15
VERIGO_ALIPAY_APP_ID=
VERIGO_ALIPAY_APP_PRIVATE_KEY=
VERIGO_ALIPAY_PUBLIC_KEY=
VERIGO_MAX_IMPORT_BYTES=5242880
VERIGO_SESSION_TTL_DAYS=30
VERIGO_SECURE_COOKIES=true

VERIGO_SENDER_EMAIL=
VERIGO_SENDER_PASSWORD=
VERIGO_PROBE_EMAIL=
VERIGO_PROBE_PASSWORD=
